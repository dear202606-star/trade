 "trigger_fns": [
  [
   "guard_locked_dataset",
   "CREATE OR REPLACE FUNCTION public.guard_locked_dataset()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  if exists (select 1 from datasets where id = coalesce(new.dataset_id, old.dataset_id)\n             and status = 'locked') then\n    raise exception 'dataset is locked; create a new version instead';\n  end if;\n  return coalesce(new, old);\nend $function$\n"
  ],
  [
   "guard_locked_months",
   "CREATE OR REPLACE FUNCTION public.guard_locked_months()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\ndeclare\n  r record;\n  sym text := case when tg_op = 'DELETE' then old.symbol else new.symbol end;\n  m   text := case when tg_op = 'DELETE' then old.month  else new.month  end;\nbegin\n  if tg_op = 'UPDATE' and new.month <> old.month then\n    raise exception 'month is immutable (attempt % -> %)', old.month, new.month;\n  end if;\n  if exists (select 1 from locked_symbols where symbol = sym) then\n    raise exception 'symbol % is locked (locked_symbols)', sym;\n  end if;\n  for r in select scope_from, scope_to from locks\n            where kind = 'monthly_prices' and status = 'locked' loop\n    if m between r.scope_from and r.scope_to then\n      raise exception 'month % is locked (% .. %)', m, r.scope_from, r.scope_to;\n    end if;\n  end loop;\n  return case when tg_op = 'DELETE' then old else new end;\nend $function$\n"
  ],
  [
   "touch_holdings",
   "CREATE OR REPLACE FUNCTION public.touch_holdings()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\n            begin\r\n              new.updated_at = now();\r\n                return new;\r\n                end;\r\n                $function$\n"
  ]
 ],
