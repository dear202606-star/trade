# .gitignore
# 编码：UTF-8。2026-11-05 修复：原文件中文内容为 GBK mojibake，
# 含中文的忽略规则与注释从未真正生效，本次重写为等价的可读规则。

data/
*.pkl
*.log

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Office / 编辑器临时文件
~$*
*.tmp

# ==========================================================
# 构建产物：docs/ 下的页面、数据、资源由 CI 生成，不入库
# ==========================================================
docs/data/
docs/assets/
docs/*.html
docs/sitemap.xml
docs/robots.txt

_archive/

# ==========================================================
# 图片与截图（正式图表按前缀放行）
# ==========================================================
*.jpg
*.jpeg
*.webp
*.bmp
*.gif
*.heic
*临时文件*
*截图*
screenshot*
Screenshot*
Screen Shot*
output/img/临时文件/
!output/img/c*.png
!output/img/f*.png
!output/img/g*.png
!output/img/r*.png

# output/ 下的一次性图表 / 缓存 / 回执（原为乱码 pattern，现等价重写）
output/*-*.png
output/_*.png
output/ui_test/
output/.panel.json
output/*applied*.json
output/*rollback*.json
output/*verification*.json
output/*shadow*.json
output/*.pdf
output/*.html
output/calendar_drift.json

# ==========================================================
# 凭据与私有配置：一律不得入库
# 2026-11-05：_legacy_backup/ 曾把第三方 API token 带进版本库，
# 该目录为数据库迁移前的一次性快照，整体移出版本控制。
# ==========================================================
output/_legacy_backup/
output/_pat_token.txt
output/_supabase.json
output/_supabase*.json
output/_supabase_dbpass.txt
output/_test_sync_code.txt
output/_api_keys*
output/_test_dispatch.sql
output/_supabase_cron_filled.sql
output/_supabase_cron.sql
output/_chrome_copy/
output/_chrome_copy2/
output/_chrome_profile/
output/_prices_cache.json
scripts_create_pat*.py
!output/supabase_cron.sql

# 通用凭据兜底
.env
.env.*
*.env
*_token.txt
*_credentials.json
*_secret*.json

# ==========================================================
# 本地研究 / 一次性脚本
# ==========================================================
futu-lowfreq/
_research/
read_positions.py
rebalance.py
probe2.py
probe3.py

/_site_release/

# 运行时状态（由看门狗当次生成，绝不入库）
output/pipeline_status_run.json
output/replication_check.json

# 本地凭据 / 数据库连接串（绝不入库）
# 2026-11-07：Neon 冷备连接串、Supabase 直连口令等只保留在本机。
output/*.local.json
output/_supabase_dbpass.txt
output/*connection_string*
backups/*.local.json
backups/*.connection.json
